[Unit]
Description=OctoClaw Legacy Runner Daemon (compat only)
After=network-online.target openclaw.service
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__SKILL_ROOT__
Environment=OCTOCLAW_ENABLE_LEGACY_LOOPS=1
Environment=WORKSPACE=__WORKSPACE__
Environment=RUNNER_POLL_INTERVAL_SECONDS=3
Environment=RUNNER_HEARTBEAT_INTERVAL_SECONDS=10
Environment=RUNNER_DEFAULT_TIMEOUT_SECONDS=120
Environment=RUNNER_MAX_AGE_MINUTES=120
Environment=RUNNER_MAX_IDLE_SECONDS=900
Environment=RUNNER_MAX_JOBS_PER_WORKER=30
ExecStartPre=/bin/rm -f __WORKSPACE__/tmp/octopus/runner-daemon.pid __WORKSPACE__/tmp/octopus/runner-health.json
ExecStart=/bin/bash __SKILL_ROOT__/lib/runner-daemon.sh
ExecStopPost=/bin/rm -f __WORKSPACE__/tmp/octopus/runner-daemon.pid __WORKSPACE__/tmp/octopus/runner-health.json
Restart=always
RestartSec=3
KillMode=control-group

[Install]
# Legacy opt-in only; not installed by default.
WantedBy=multi-user.target
