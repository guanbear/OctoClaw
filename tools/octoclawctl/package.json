{
  "name": "@octoclaw/cli",
  "version": "0.6.0",
  "type": "module",
  "main": "dist/cli.js",
  "types": "src/cli.ts",
  "bin": {
    "octoclawctl": "./dist/cli.js",
    "octoclaw": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/cli.ts",
      "default": "./dist/cli.js"
    }
  },
  "dependencies": {
    "@octoclaw/policy": "workspace:*",
    "@octoclaw/router": "workspace:*",
    "@octoclaw/runtime": "workspace:*",
    "@octoclaw/status-surface": "workspace:*",
    "@inquirer/prompts": "^7.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run src/*.test.ts src/**/*.test.ts --root ../.."
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
