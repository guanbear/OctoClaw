{
  "name": "@octoclaw/runtime-core",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/workflow/index.js",
  "types": "dist/workflow/index.d.ts",
  "exports": {
    ".": { "types": "./dist/workflow/index.d.ts", "default": "./dist/workflow/index.js" },
    "./ack": { "types": "./dist/ack/index.d.ts", "default": "./dist/ack/index.js" },
    "./requests": { "types": "./dist/requests/index.d.ts", "default": "./dist/requests/index.js" },
    "./tasks": { "types": "./dist/tasks/index.d.ts", "default": "./dist/tasks/index.js" },
    "./workflow": { "types": "./dist/workflow/index.d.ts", "default": "./dist/workflow/index.js" },
    "./delivery": { "types": "./dist/delivery/protocol.d.ts", "default": "./dist/delivery/protocol.js" },
    "./recovery": { "types": "./dist/recovery/index.d.ts", "default": "./dist/recovery/index.js" },
    "./telemetry": { "types": "./dist/telemetry/index.d.ts", "default": "./dist/telemetry/index.js" },
    "./im": { "types": "./dist/im/index.d.ts", "default": "./dist/im/index.js" }
  },
  "dependencies": {
    "@octoclaw/contracts": "workspace:*",
    "@octoclaw/policy": "workspace:*"
  },
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "files": ["dist"]
}
