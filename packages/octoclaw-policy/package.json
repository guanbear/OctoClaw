    "./judge": { "types": "./dist/judge/index.d.ts", "default": "./dist/judge/index.js" },
    "./judge-schema": { "types": "./dist/judge/judge-schema.d.ts", "default": "./dist/judge/judge-schema.js" },
    "./judge-prompt": { "types": "./dist/judge/judge-prompt.d.ts", "default": "./dist/judge/judge-prompt.js" },
    "./spec": { "types": "./dist/spec/index.d.ts", "default": "./dist/spec/index.js" },
    "./route": { "types": "./dist/route/index.d.ts", "default": "./dist/route/index.js" },
    "./model": { "types": "./dist/model/index.d.ts", "default": "./dist/model/index.js" },
    "./gate": { "types": "./dist/gate/index.d.ts", "default": "./dist/gate/index.js" },
    "./roles": { "types": "./dist/roles/index.d.ts", "default": "./dist/roles/index.js" },
