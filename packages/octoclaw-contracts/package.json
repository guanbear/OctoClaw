    "./thread-binding": { "types": "./dist/thread-binding.d.ts", "default": "./dist/thread-binding.js" },
    "./completion": { "types": "./dist/completion.d.ts", "default": "./dist/completion.js" }
  },
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
