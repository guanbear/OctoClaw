{
  "name": "octoclaw-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r --stream run build",
    "check": "pnpm build && pnpm -r --stream run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:openclaw-baseline": "node scripts/verify-openclaw-baseline.mjs",
