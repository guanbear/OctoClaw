{
  "name": "@octoclaw/fast-reply",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./ack": { "types": "./dist/ack/index.d.ts", "default": "./dist/ack/index.js" },
    "./direct": { "types": "./dist/direct/index.d.ts", "default": "./dist/direct/index.js" },
    "./instrumentation": { "types": "./dist/instrumentation/index.d.ts", "default": "./dist/instrumentation/index.js" }
  },
  "dependencies": {
    "@octoclaw/contracts": "workspace:*",
    "@octoclaw/policy": "workspace:*",
    "@octoclaw/runtime-core": "workspace:*"
  },
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "files": ["dist"]
}
