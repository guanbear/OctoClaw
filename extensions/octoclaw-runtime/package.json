{
  "name": "octoclaw-runtime",
  "version": "0.1.0",
  "description": "OpenClaw extension tools for OctoClaw routing, dispatch, and status",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "src/plugin.ts",
    "policy",
    "openclaw.plugin.json"
  ],
  "exports": {
    ".": "./index.js",
    "./plugin": "./src/plugin.ts"
  },
  "openclaw": {
    "extensions": [
      "./index.js",
      "./src/plugin.ts"
    ]
  }
}
