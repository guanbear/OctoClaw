{
  "id": "octoclaw-runtime",
  "name": "OctoClaw Runtime",
  "description": "Runtime policy hooks, dispatch tools, and replay logging for OctoClaw",
  "version": "0.3.0",
  "main": "./dist/extension-entry.js",
  "extensions": [
    "./dist/extension-entry.js"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "octoclawRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Override OCTOCLAW_ROOT path"
      },
      "workspaceRoot": {
        "type": "string",
        "minLength": 1,
        "description": "Override WORKSPACE_ROOT path"
      },
      "ackTimerFirstTierMs": {
        "type": "number",
        "minimum": 10000,
        "description": "ACK timer first tier timeout in milliseconds (default 60000)"
      },
      "ackTimerTierCount": {
        "type": "number",
        "minimum": 1,
        "maximum": 6,
        "description": "ACK timer tier count (default 3, max 6)"
      },
      "delegationEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable delegation/runner routing. When false, all requests go direct (reply)"
      },
      "judgeFast": {
        "type": "object",
        "description": "LLM semantic routing judge configuration",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "shadowMode": {
            "type": "boolean",
            "default": false
          },
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "baseUrl": {
            "type": "string",
            "minLength": 1
          },
          "apiKey": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "number",
            "minimum": 500,
            "default": 3000
          },
          "timeoutLocalMs": {
            "type": "number",
            "minimum": 300,
            "default": 800
          },
          "minConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.6
          },
          "local": {
            "type": "boolean",
            "default": false
          },
          "judgeAckEnabled": {
            "type": "boolean",
            "description": "Use judge-generated ack_text. Local default true, remote default false."
          },
          "ackReactionEmoji": {
            "type": "string",
            "description": "Emoji name to react with on message receipt (e.g. 'ok_hand'). Empty to disable.",
            "default": ""
          }
        },
        "required": ["modelId", "baseUrl", "apiKey"],
        "additionalProperties": false
      }
    }
  }
}
