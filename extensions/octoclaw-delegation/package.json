{
  "name": "@octoclaw/delegation",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./brief": { "types": "./dist/brief/index.d.ts", "default": "./dist/brief/index.js" },
    "./profiles": { "types": "./dist/profiles/index.d.ts", "default": "./dist/profiles/index.js" },
    "./materialize": { "types": "./dist/materialize/index.d.ts", "default": "./dist/materialize/index.js" },
    "./compound": { "types": "./dist/compound/index.d.ts", "default": "./dist/compound/index.js" },
    "./conflicts": { "types": "./dist/conflicts/index.d.ts", "default": "./dist/conflicts/index.js" }
  },
  "dependencies": {
    "@octoclaw/contracts": "workspace:*",
    "@octoclaw/policy": "workspace:*",
    "@octoclaw/runtime-core": "workspace:*"
  },
  "scripts": {
    "build": "tsc --build",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "files": ["dist"]
}
