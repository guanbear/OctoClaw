{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octoclaw.dev/schemas/runtime-policy-replay-event-v1.schema.json",
  "title": "OctoClaw Runtime Policy Replay Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event",
    "at",
    "sessionKey",
    "sessionId"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "octoclaw.runtime_policy.replay_event/v1"
    },
    "event": {
      "type": "string",
      "enum": [
        "policy_resolved",
        "route_hint_submitted",
        "tool_blocked_before_route_hint",
        "tool_blocked_manual_delegation",
        "tool_blocked_control_observer",
        "tool_blocked_session_control",
        "tool_blocked_runner_policy",
        "tool_blocked_delegation_policy",
        "direct_tool_called",
        "dispatch_called",
        "agent_end"
      ]
    },
    "at": { "type": "string" },
    "sessionKey": { "type": "string" },
    "sessionId": { "type": "string" },
    "trigger": { "type": "string" },
    "route": { "type": "string" },
    "systemPreferredRoute": { "type": "string" },
    "workerPool": { "type": "string" },
    "taskClass": { "type": "string" },
    "protectedLane": { "type": "string" },
    "workContract": { "type": "string" },
    "workContractHint": { "type": "string" },
    "budgetPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget_cap": { "type": "string" },
        "retry_cap": { "type": "integer" },
        "max_workers": { "type": "integer" },
        "latency_target": { "type": "string" },
        "interruptibility": { "type": "string" },
        "upgrade_allowed": { "type": "boolean" }
      }
    },
    "routeRecommendation": { "$ref": "route-recommendation-v1.schema.json" },
    "budgetRecommendation": { "$ref": "budget-recommendation-v1.schema.json" },
    "routeOutcome": { "$ref": "route-outcome-v1.schema.json" },
    "autoRouter": {
      "type": "object"
    },
    "routeHintRequired": { "type": "boolean" },
    "routeHintSubmitted": { "type": "boolean" },
    "stateGroundingRequired": { "type": "boolean" },
    "latencyAckRequired": { "type": "boolean" },
    "latencyAckSent": { "type": "boolean" },
    "latencyAckReason": { "type": "string" },
    "stickyApplied": { "type": "boolean" },
    "stickyPersisted": { "type": "boolean" },
    "ackFollowupCandidate": { "type": "boolean" },
    "ackFollowupApplied": { "type": "boolean" },
    "prompt": { "type": "string" },
    "toolName": { "type": "string" },
    "requiredTool": { "type": "string" },
    "routeHint": { "type": "string" },
    "workType": { "type": "string" },
    "phase": { "type": "string" },
    "reviewRequired": { "type": "boolean" },
    "confidence": { "type": "number" },
    "reason": { "type": "string" },
    "finalRoute": { "type": "string" },
    "executed": { "type": "boolean" },
    "taskId": { "type": "string" },
    "runnerJobId": { "type": "string" },
    "usedCachedPolicy": { "type": "boolean" },
    "delegated": { "type": "boolean" },
    "delegationTool": { "type": "string" },
    "materialization": { "type": "object" },
    "capability_failure": { "type": "object" },
    "blockedTools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "routeLanguagePacks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "executionContract": { "type": "string" },
    "agentScope": { "type": "string" },
    "routeClass": { "type": "string" },
    "recommendedModel": { "type": "string" },
    "resolvedModel": { "type": "string" },
    "outputBudget": { "type": "string" },
    "reasoningMode": { "type": "string" },
    "candidateModels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "routeSource": { "type": "string" },
    "fallbackTaken": { "type": "boolean" },
    "runnerHealthSnapshot": {
      "type": "object"
    },
    "queuePressureBand": { "type": "string" },
    "quotaPressureBand": { "type": "string" },
    "actualCost": { "type": ["number", "integer", "null"] },
    "actualLatency": { "type": ["number", "integer", "null"] },
    "validationOutcome": { "type": "string" }
  }
}
