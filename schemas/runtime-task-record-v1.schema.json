{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octoclaw.dev/schemas/runtime-task-record-v1.schema.json",
  "title": "OctoClaw Runtime Task Record v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "source",
    "route",
    "runtime",
    "executor",
    "executor_type",
    "worker_pool",
    "work_type",
    "phase",
    "protocol",
    "review_required",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "octoclaw.runtime_task.record/v1"
    },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "status": { "type": "string" },
    "source": { "type": "string" },
    "route": { "type": "string" },
    "runtime": { "type": "string" },
    "executor": { "type": "string" },
    "executor_type": { "type": "string" },
    "worker_pool": { "type": "string" },
    "work_type": { "type": "string" },
    "phase": { "type": "string" },
    "protocol": { "type": "string" },
    "profile": { "type": "string" },
    "review_required": { "type": "boolean" },
    "task_kind": { "type": "string" },
    "owner": { "type": "string" },
    "session_key": { "type": "string" },
    "session_origin": { "type": "string" },
    "session_target": { "type": "string" },
    "session_thread_id": { "type": "string" },
    "session_thread_key": { "type": "string" },
    "agent_id": { "type": "string" },
    "agent_namespace": { "type": "string" },
    "managed_by_octoclaw": { "type": "boolean" },
    "model_band": { "type": "string" },
    "model": { "type": "string" },
    "summary": { "type": "string" },
    "lifecycle_state": { "type": "string" },
    "outcome_state": { "type": "string" },
    "handoff_state": { "type": "string" },
    "blocked_on": { "type": "string" },
    "blocked_reason": { "type": "string" },
    "deliverable_kind": { "type": "string" },
    "user_safe_summary": { "type": "string" },
    "result_ready_at": { "type": "string" },
    "handoff_ready_at": { "type": "string" },
    "observability_health": { "type": "string" },
    "task_description": { "type": "string" },
    "parent_id": { "type": "string" },
    "deps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "child_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "report_path": { "type": "string" },
    "context_path": { "type": "string" },
    "context_summary": { "type": "string" },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "spawned_at": { "type": "string" },
    "spawn_intent_id": { "type": "string" },
    "spawnIntentId": { "type": "string" },
    "spawn_backend": {
      "type": "string",
      "enum": ["sessions_spawn_planner", "legacy", "direct"]
    },
    "spawnBackend": {
      "type": "string",
      "enum": ["sessions_spawn_planner", "legacy", "direct"]
    },
    "openclaw_run_id": { "type": "string" },
    "openclawRunId": { "type": "string" },
    "child_run_id": { "type": "string" },
    "childRunId": { "type": "string" },
    "child_session_key": { "type": "string" },
    "childSessionKey": { "type": "string" },
    "native_spawn_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openclaw_run_id": { "type": "string" },
        "child_session_key": { "type": "string" },
        "requester_session_key": { "type": "string" },
        "spawn_intent_id": { "type": "string" },
        "spawn_backend": {
          "type": "string",
          "enum": ["sessions_spawn_planner", "legacy", "direct"]
        },
        "spawn_mode": { "type": "string" }
      }
    },
    "nativeSpawnRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openclawRunId": { "type": "string" },
        "childSessionKey": { "type": "string" },
        "requesterSessionKey": { "type": "string" },
        "spawnIntentId": { "type": "string" },
        "spawnBackend": {
          "type": "string",
          "enum": ["sessions_spawn_planner", "legacy", "direct"]
        },
        "spawnMode": { "type": "string" }
      }
    },
    "started_at": { "type": "string" },
    "completed_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "session_id": { "type": "string" },
    "run_id": { "type": "string" },
    "session_status": { "type": "string" },
    "last_observed_at": { "type": "string" },
    "recovery_action": { "type": "string" },
    "retry_count": { "type": "integer" },
    "expected_done_at": { "type": "string" },
    "artifacts": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
