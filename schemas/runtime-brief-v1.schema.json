{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OctoClaw Runtime Brief v1",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "goal",
    "constraints",
    "expected_output"
  ],
  "properties": {
    "schema_version": {
      "const": "octoclaw.brief/v1"
    },
    "task_id": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "worker_pool": {
      "type": "string"
    },
    "work_type": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "protocol": {
      "type": "string"
    },
    "review_required": {
      "type": "boolean"
    },
    "expected_done": {
      "type": "string"
    },
    "boundary": {
      "type": "object"
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "done_definition": {
      "type": "string"
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_summary": {
      "type": "string"
    },
    "context_path": {
      "type": "string"
    },
    "context_pack": {
      "type": "object"
    },
    "context_budget": {
      "type": "object"
    },
    "checklist_delta": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retrieval_hints": {
      "type": "object"
    },
    "skill_bundle": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_output": {
      "$ref": "./worker-result-v1.schema.json"
    }
  },
  "additionalProperties": true
}
