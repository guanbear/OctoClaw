{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octoclaw.dev/schemas/runtime-policy-decision-v1.schema.json",
  "title": "OctoClaw Runtime Policy Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "summary",
    "request",
    "route_decision",
    "budget_policy",
    "model_policy",
    "skill_policy",
    "review_policy",
    "route_recommendation",
    "prompt_contract",
    "pre_dispatch_ack",
    "state_grounding",
    "latency_ack",
    "tool_policy",
    "route_hint_policy",
    "runtime_switches",
    "hook_interface"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "octoclaw.runtime_policy.decision/v1"
    },
    "generated_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": ["task", "command", "channel", "session_key", "metadata"],
      "properties": {
        "task": { "type": "string" },
        "command": { "type": "string" },
        "channel": { "type": "string" },
        "session_key": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "route_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "system_preferred_route",
        "work_contract",
        "work_contract_hint",
        "protected_lane",
        "dispatch_required",
        "confidence",
        "reason",
        "reason_codes",
        "scores",
        "task_class",
        "executor_type",
        "worker_pool",
        "work_type",
        "phase",
        "protocol",
        "should_wait",
        "wait_timeout_seconds",
        "expected_latency_ms",
        "expected_cost_band",
        "context_growth_band",
        "parallel_gain_band",
        "artifact_required",
        "durable_runtime_required"
      ],
      "properties": {
        "route": {
          "type": "string",
          "enum": ["direct", "reply", "delegate", "runner", "spawn_single", "spawn_multi"]
        },
        "system_preferred_route": {
          "type": "string",
          "enum": ["direct", "reply", "delegate", "runner", "spawn_single", "spawn_multi"]
        },
        "work_contract": {
          "type": "string",
          "enum": ["answer_now", "inspect_report", "deliverable_work", "coordinated_work"]
        },
        "work_contract_hint": {
          "type": "string",
          "enum": ["answer_now", "inspect_report", "deliverable_work", "coordinated_work"]
        },
        "protected_lane": { "type": "string" },
        "dispatch_required": { "type": "boolean" },
        "dispatch_status": {
          "type": "string",
          "enum": ["not_required", "dispatch_required", "requires_native_spawn", "spawn_confirmed", "failed"]
        },
        "dispatch_method": {
          "type": "string",
          "enum": ["none", "octoclaw_dispatch", "octoclaw_dispatch_planner", "legacy"]
        },
        "spawn_backend": {
          "type": "string",
          "enum": ["sessions_spawn_planner", "legacy", "direct", "off"]
        },
        "spawn_intent_id": { "type": "string" },
        "spawnIntentId": { "type": "string" },
        "work_contract_id": { "type": "string" },
        "workContractId": { "type": "string" },
        "confidence": { "type": "number" },
        "reason": { "type": "string" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scores": {
          "type": "object",
          "additionalProperties": true
        },
        "task_class": { "type": "string" },
        "executor_type": {
          "type": "string",
          "enum": ["main", "runner", "subagent", "team"]
        },
        "worker_pool": { "type": "string" },
        "work_type": {
          "type": "string",
          "enum": ["ops", "research", "code", "review"]
        },
        "phase": { "type": "string" },
        "protocol": {
          "type": "string",
          "enum": ["normal", "heavy"]
        },
        "should_wait": { "type": "boolean" },
        "wait_timeout_seconds": { "type": "integer" },
        "expected_latency_ms": { "type": "integer" },
        "expected_cost_band": { "type": "string" },
        "context_growth_band": { "type": "string" },
        "parallel_gain_band": { "type": "string" },
        "artifact_required": { "type": "boolean" },
        "durable_runtime_required": { "type": "boolean" }
      }
    },
    "budget_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_cap",
        "retry_cap",
        "max_workers",
        "latency_target",
        "interruptibility",
        "upgrade_allowed"
      ],
      "properties": {
        "budget_cap": { "type": "string" },
        "retry_cap": { "type": "integer" },
        "max_workers": { "type": "integer" },
        "latency_target": { "type": "string" },
        "interruptibility": { "type": "string" },
        "upgrade_allowed": { "type": "boolean" }
      }
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_pool",
        "model_selector_role",
        "selector_band",
        "model_band",
        "selected_model",
        "profile",
        "reasoning_effort",
        "fallbacks"
      ],
      "properties": {
        "worker_pool": { "type": "string" },
        "model_selector_role": { "type": "string" },
        "selector_band": { "type": "string" },
        "model_band": { "type": "string" },
        "selected_model": { "type": "string" },
        "profile": { "type": "string" },
        "reasoning_effort": { "type": "string" },
        "fallbacks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "route_recommendation": {
      "$ref": "./route-recommendation-v1.schema.json"
    },
    "budget_recommendation": {
      "$ref": "./budget-recommendation-v1.schema.json"
    },
    "auto_router": {
      "type": "object",
      "additionalProperties": true
    },
    "skill_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_skill_bundle", "dynamic_discovery_allowed"],
      "properties": {
        "default_skill_bundle": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dynamic_discovery_allowed": { "type": "boolean" }
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "review_worker_pool", "review_trigger"],
      "properties": {
        "required": { "type": "boolean" },
        "review_worker_pool": { "type": "string" },
        "review_trigger": { "type": "string" }
      }
    },
    "route_recommendation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "recommended_route",
        "recommended_worker_pool",
        "recommended_work_type",
        "recommended_phase",
        "recommended_model_band",
        "protected_lane",
        "bypass_delegated_optimization",
        "work_contract_hint",
        "top_candidates",
        "arbitration",
        "reason_codes"
      ],
      "properties": {
        "schema_version": { "type": "string" },
        "recommended_route": { "type": "string" },
        "recommended_worker_pool": { "type": "string" },
        "recommended_work_type": { "type": "string" },
        "recommended_phase": { "type": "string" },
        "recommended_model_band": { "type": "string" },
        "protected_lane": { "type": "string" },
        "bypass_delegated_optimization": { "type": "boolean" },
        "work_contract_hint": { "type": "string" },
        "top_candidates": { "type": "array", "items": { "type": "object" } },
        "arbitration": { "type": "object" },
        "reason_codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prompt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_required",
        "work_contract",
        "artifact_first",
        "transcript_to_main",
        "summary_required",
        "checkpoint_summary_required",
        "direct_reply_allowed",
        "final_answer_from_handoff",
        "final_compose_required",
        "user_safe_summary_required",
        "child_results_are_evidence",
        "merge_contract",
        "handoff_contract",
        "review_gate_required"
      ],
      "properties": {
        "brief_required": { "type": "boolean" },
        "work_contract": { "type": "string" },
        "artifact_first": { "type": "boolean" },
        "transcript_to_main": { "type": "boolean" },
        "summary_required": { "type": "boolean" },
        "checkpoint_summary_required": { "type": "boolean" },
        "direct_reply_allowed": { "type": "boolean" },
        "final_answer_from_handoff": { "type": "boolean" },
        "final_compose_required": { "type": "boolean" },
        "user_safe_summary_required": { "type": "boolean" },
        "child_results_are_evidence": { "type": "boolean" },
        "merge_contract": { "type": "string" },
        "handoff_contract": { "type": "string" },
        "review_gate_required": { "type": "boolean" }
      }
    },
    "pre_dispatch_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "style",
        "channel_delivery_preferred",
        "fallback_to_progress_update",
        "text"
      ],
      "properties": {
        "required": { "type": "boolean" },
        "style": { "type": "string" },
        "channel_delivery_preferred": { "type": "boolean" },
        "fallback_to_progress_update": { "type": "boolean" },
        "text": { "type": "string" }
      }
    },
    "state_grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "source", "subject", "fallback_to_control_tools"],
      "properties": {
        "required": { "type": "boolean" },
        "source": { "type": "string" },
        "subject": { "type": "string" },
        "fallback_to_control_tools": { "type": "boolean" }
      }
    },
    "latency_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "style", "channel_delivery_preferred", "text"],
      "properties": {
        "required": { "type": "boolean" },
        "style": { "type": "string" },
        "channel_delivery_preferred": { "type": "boolean" },
        "text": { "type": "string" }
      }
    },
    "tool_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_direct_tools",
        "must_delegate_via",
        "allowed_control_tools",
        "observer_control_tools",
        "session_control_tools",
        "control_observer_only",
        "session_control_only",
        "delegate_first",
        "block_tool_patterns"
      ],
      "properties": {
        "allow_direct_tools": { "type": "boolean" },
        "must_delegate_via": { "type": "string" },
        "allowed_control_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observer_control_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "session_control_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "control_observer_only": { "type": "boolean" },
        "session_control_only": { "type": "boolean" },
        "delegate_first": { "type": "boolean" },
        "block_tool_patterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "route_hint_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "hard_gate_applied",
        "hard_gate_reason",
        "submitted",
        "source",
        "accepted_routes",
        "system_preferred_route",
        "final_route",
        "hint_route",
        "hint_work_type",
        "hint_phase",
        "hint_review_required",
        "hint_confidence",
        "hint_reason",
        "merge_notes",
        "sticky_applied",
        "sticky_route",
        "sticky_work_type",
        "sticky_work_contract",
        "sticky_applied_count",
        "sticky_decay_blocked",
        "sticky_goal_shift_blocked",
        "ack_followup_candidate",
        "ack_followup_applied"
      ],
      "properties": {
        "required": { "type": "boolean" },
        "hard_gate_applied": { "type": "boolean" },
        "hard_gate_reason": { "type": "string" },
        "submitted": { "type": "boolean" },
        "source": { "type": "string" },
        "accepted_routes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "system_preferred_route": { "type": "string" },
        "final_route": { "type": "string" },
        "hint_route": { "type": "string" },
        "hint_work_type": { "type": "string" },
        "hint_phase": { "type": "string" },
        "hint_review_required": { "type": "boolean" },
        "hint_confidence": { "type": "number" },
        "hint_reason": { "type": "string" },
        "merge_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sticky_applied": { "type": "boolean" },
        "sticky_route": { "type": "string" },
        "sticky_work_type": { "type": "string" },
        "sticky_work_contract": { "type": "string" },
        "sticky_applied_count": { "type": "integer" },
        "sticky_decay_blocked": { "type": "boolean" },
        "sticky_goal_shift_blocked": { "type": "boolean" },
        "ack_followup_candidate": { "type": "boolean" },
        "ack_followup_applied": { "type": "boolean" }
      }
    },
    "runtime_switches": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_enabled",
        "hard_runner_only_enabled",
        "route_hint_required_enabled",
        "replay_logging_enabled",
        "direct_model_override_enabled",
        "delegation_enforcement_enabled",
        "sticky_lane_enabled",
        "ack_followup_enabled"
      ],
      "properties": {
        "policy_enabled": { "type": "boolean" },
        "hard_runner_only_enabled": { "type": "boolean" },
        "route_hint_required_enabled": { "type": "boolean" },
        "replay_logging_enabled": { "type": "boolean" },
        "direct_model_override_enabled": { "type": "boolean" },
        "delegation_enforcement_enabled": { "type": "boolean" },
        "sticky_lane_enabled": { "type": "boolean" },
        "ack_followup_enabled": { "type": "boolean" }
      }
    },
    "hook_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_model_resolve",
        "before_prompt_build",
        "before_tool_call",
        "agent_end"
      ],
      "properties": {
        "before_model_resolve": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "selected_model",
            "profile",
            "reasoning_effort",
            "dispatch_required"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "action": { "type": "string" },
            "selected_model": { "type": "string" },
            "profile": { "type": "string" },
            "reasoning_effort": { "type": "string" },
            "dispatch_required": { "type": "boolean" }
          }
        },
        "before_prompt_build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "policy_context",
            "skill_bundle",
            "prompt_contract"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "action": { "type": "string" },
            "policy_context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "route",
                "worker_pool",
                "work_type",
                "phase",
                "protocol",
                "review_required",
                "route_hint_required",
                "route_hint_submitted"
              ],
              "properties": {
                "route": { "type": "string" },
                "worker_pool": { "type": "string" },
                "work_type": { "type": "string" },
                "phase": { "type": "string" },
                "protocol": { "type": "string" },
                "review_required": { "type": "boolean" },
                "route_hint_required": { "type": "boolean" },
                "route_hint_submitted": { "type": "boolean" }
              }
            },
            "skill_bundle": {
              "type": "array",
              "items": { "type": "string" }
            },
            "prompt_contract": {
              "$ref": "#/properties/prompt_contract"
            }
          }
        },
        "before_tool_call": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "action", "tool_policy", "route_hint_required", "route_hint_submitted", "route_hint_tool"],
          "properties": {
            "enabled": { "type": "boolean" },
            "action": { "type": "string" },
            "tool_policy": {
              "$ref": "#/properties/tool_policy"
            },
            "route_hint_required": { "type": "boolean" },
            "route_hint_submitted": { "type": "boolean" },
            "route_hint_tool": { "type": "string" }
          }
        },
        "agent_end": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "artifact_first",
            "review_required",
            "final_compose_required",
            "route_hint_required",
            "route_hint_submitted"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "action": { "type": "string" },
            "artifact_first": { "type": "boolean" },
            "review_required": { "type": "boolean" },
            "final_compose_required": { "type": "boolean" },
            "route_hint_required": { "type": "boolean" },
            "route_hint_submitted": { "type": "boolean" }
          }
        }
      }
    }
  }
}
