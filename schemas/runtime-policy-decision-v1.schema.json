{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octoclaw.dev/schemas/runtime-policy-decision-v1.schema.json",
  "title": "OctoClaw Runtime Policy Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "summary",
    "request",
    "route_decision",
    "model_policy",
    "skill_policy",
    "review_policy",
    "prompt_contract",
    "tool_policy",
    "route_hint_policy",
    "runtime_switches",
    "compat",
    "hook_interface"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "octoclaw.runtime_policy.decision/v1"
    },
    "generated_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": ["task", "command", "channel", "session_key", "metadata"],
      "properties": {
        "task": { "type": "string" },
        "command": { "type": "string" },
        "channel": { "type": "string" },
        "session_key": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "route_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "system_preferred_route",
        "dispatch_required",
        "confidence",
        "reason",
        "reason_codes",
        "scores",
        "task_class",
        "executor_type",
        "worker_pool",
        "work_type",
        "phase",
        "protocol",
        "should_wait",
        "wait_timeout_seconds",
        "expected_latency_ms",
        "expected_cost_band",
        "context_growth_band"
      ],
      "properties": {
        "route": {
          "type": "string",
          "enum": ["direct", "runner", "spawn_single", "spawn_multi"]
        },
        "system_preferred_route": {
          "type": "string",
          "enum": ["direct", "runner", "spawn_single", "spawn_multi"]
        },
        "dispatch_required": { "type": "boolean" },
        "confidence": { "type": "number" },
        "reason": { "type": "string" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scores": {
          "type": "object",
          "additionalProperties": true
        },
        "task_class": { "type": "string" },
        "executor_type": {
          "type": "string",
          "enum": ["main", "runner", "subagent", "team"]
        },
        "worker_pool": { "type": "string" },
        "work_type": {
          "type": "string",
          "enum": ["ops", "research", "code", "review"]
        },
        "phase": { "type": "string" },
        "protocol": {
          "type": "string",
          "enum": ["normal", "heavy"]
        },
        "should_wait": { "type": "boolean" },
        "wait_timeout_seconds": { "type": "integer" },
        "expected_latency_ms": { "type": "integer" },
        "expected_cost_band": { "type": "string" },
        "context_growth_band": { "type": "string" }
      }
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_pool",
        "model_selector_role",
        "selector_tier",
        "tier",
        "selected_model",
        "profile",
        "reasoning_effort",
        "fallbacks"
      ],
      "properties": {
        "worker_pool": { "type": "string" },
        "model_selector_role": { "type": "string" },
        "selector_tier": { "type": "string" },
        "legacy_label": { "type": "string" },
        "legacy_tier": { "type": "string" },
        "tier": { "type": "string" },
        "selected_model": { "type": "string" },
        "profile": { "type": "string" },
        "reasoning_effort": { "type": "string" },
        "fallbacks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "skill_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_skill_bundle", "dynamic_discovery_allowed"],
      "properties": {
        "default_skill_bundle": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dynamic_discovery_allowed": { "type": "boolean" }
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "review_worker_pool", "review_trigger"],
      "properties": {
        "required": { "type": "boolean" },
        "review_worker_pool": { "type": "string" },
        "review_trigger": { "type": "string" }
      }
    },
    "prompt_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_required",
        "artifact_first",
        "transcript_to_main",
        "summary_required",
        "checkpoint_summary_required",
        "direct_reply_allowed",
        "final_answer_from_handoff"
      ],
      "properties": {
        "brief_required": { "type": "boolean" },
        "artifact_first": { "type": "boolean" },
        "transcript_to_main": { "type": "boolean" },
        "summary_required": { "type": "boolean" },
        "checkpoint_summary_required": { "type": "boolean" },
        "direct_reply_allowed": { "type": "boolean" },
        "final_answer_from_handoff": { "type": "boolean" }
      }
    },
    "tool_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_direct_tools",
        "must_delegate_via",
        "allowed_control_tools",
        "delegate_first",
        "block_tool_patterns"
      ],
      "properties": {
        "allow_direct_tools": { "type": "boolean" },
        "must_delegate_via": { "type": "string" },
        "allowed_control_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "delegate_first": { "type": "boolean" },
        "block_tool_patterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "route_hint_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "hard_gate_applied",
        "hard_gate_reason",
        "submitted",
        "source",
        "accepted_routes",
        "system_preferred_route",
        "final_route",
        "hint_route",
        "hint_work_type",
        "hint_phase",
        "hint_review_required",
        "hint_confidence",
        "hint_reason",
        "merge_notes",
        "sticky_applied",
        "sticky_route",
        "sticky_work_type"
      ],
      "properties": {
        "required": { "type": "boolean" },
        "hard_gate_applied": { "type": "boolean" },
        "hard_gate_reason": { "type": "string" },
        "submitted": { "type": "boolean" },
        "source": { "type": "string" },
        "accepted_routes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "system_preferred_route": { "type": "string" },
        "final_route": { "type": "string" },
        "hint_route": { "type": "string" },
        "hint_work_type": { "type": "string" },
        "hint_phase": { "type": "string" },
        "hint_review_required": { "type": "boolean" },
        "hint_confidence": { "type": "number" },
        "hint_reason": { "type": "string" },
        "merge_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sticky_applied": { "type": "boolean" },
        "sticky_route": { "type": "string" },
        "sticky_work_type": { "type": "string" }
      }
    },
    "runtime_switches": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_enabled",
        "hard_runner_only_enabled",
        "route_hint_required_enabled",
        "replay_logging_enabled",
        "direct_model_override_enabled",
        "delegation_enforcement_enabled",
        "sticky_lane_enabled"
      ],
      "properties": {
        "policy_enabled": { "type": "boolean" },
        "hard_runner_only_enabled": { "type": "boolean" },
        "route_hint_required_enabled": { "type": "boolean" },
        "replay_logging_enabled": { "type": "boolean" },
        "direct_model_override_enabled": { "type": "boolean" },
        "delegation_enforcement_enabled": { "type": "boolean" },
        "sticky_lane_enabled": { "type": "boolean" }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy_role_hint", "legacy_tier_hint"],
      "properties": {
        "legacy_role_hint": { "type": "string" },
        "legacy_tier_hint": { "type": "string" }
      }
    },
    "hook_interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_model_resolve",
        "before_prompt_build",
        "before_tool_call",
        "agent_end"
      ],
      "properties": {
        "before_model_resolve": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "selected_model",
            "profile",
            "reasoning_effort",
            "dispatch_required"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "action": { "type": "string" },
            "selected_model": { "type": "string" },
            "profile": { "type": "string" },
            "reasoning_effort": { "type": "string" },
            "dispatch_required": { "type": "boolean" }
          }
        },
        "before_prompt_build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "policy_context",
            "skill_bundle",
            "prompt_contract"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "action": { "type": "string" },
            "policy_context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "route",
                "worker_pool",
                "work_type",
                "phase",
                "protocol",
                "review_required"
              ],
              "properties": {
              "route": { "type": "string" },
              "worker_pool": { "type": "string" },
              "work_type": { "type": "string" },
              "phase": { "type": "string" },
              "protocol": { "type": "string" },
              "review_required": { "type": "boolean" },
              "route_hint_required": { "type": "boolean" },
              "route_hint_submitted": { "type": "boolean" }
            }
          },
            "skill_bundle": {
              "type": "array",
              "items": { "type": "string" }
            },
            "prompt_contract": {
              "$ref": "#/properties/prompt_contract"
            }
          }
        },
        "before_tool_call": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "action", "tool_policy", "route_hint_required", "route_hint_submitted", "route_hint_tool"],
          "properties": {
            "enabled": { "type": "boolean" },
            "action": { "type": "string" },
            "tool_policy": {
              "$ref": "#/properties/tool_policy"
            },
            "route_hint_required": { "type": "boolean" },
            "route_hint_submitted": { "type": "boolean" },
            "route_hint_tool": { "type": "string" }
          }
        },
        "agent_end": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "action",
            "artifact_first",
            "review_required",
            "final_compose_required",
            "route_hint_required",
            "route_hint_submitted"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "action": { "type": "string" },
            "artifact_first": { "type": "boolean" },
            "review_required": { "type": "boolean" },
            "final_compose_required": { "type": "boolean" },
            "route_hint_required": { "type": "boolean" },
            "route_hint_submitted": { "type": "boolean" }
          }
        }
      }
    }
  }
}
